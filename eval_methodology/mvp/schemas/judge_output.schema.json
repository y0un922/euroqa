{
  "type": "object",
  "additionalProperties": false,
  "required": ["claims", "citations"],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "supported"],
        "properties": {
          "text": { "type": "string" },
          "supported": { "type": "boolean" }
        }
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref_label", "valid"],
        "properties": {
          "ref_label": { "type": "string" },
          "valid": { "type": "boolean" }
        }
      }
    },
    "gold_evidence_coverages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "covered"],
        "properties": {
          "evidence_id": { "type": "string" },
          "covered": { "type": "boolean" }
        }
      }
    }
  }
}
