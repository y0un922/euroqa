{
  "type": "object",
  "additionalProperties": false,
  "required": ["reference_answer", "evidence", "claims"],
  "properties": {
    "reference_answer": {"type": "string"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "document_path", "section", "quote"],
        "properties": {
          "evidence_id": {"type": "string"},
          "document_path": {"type": "string"},
          "section": {"type": "string"},
          "quote": {"type": "string"}
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "text", "status", "evidence_ids"],
        "properties": {
          "claim_id": {"type": "string"},
          "text": {"type": "string"},
          "status": {"type": "string", "enum": ["supported", "corpus_gap"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
